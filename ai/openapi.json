{
  "openapi": "3.0.3",
  "info": {
    "title": "LexWatch AI",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/embed": {
      "post": {
        "summary": "Embed",
        "operationId": "embed",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/classify": {
      "post": {
        "summary": "Classify Endpoint",
        "operationId": "classify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "summary": "Analyze Endpoint",
        "operationId": "analyze",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/critique": {
      "post": {
        "summary": "Critique Endpoint",
        "operationId": "critique",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CritiqueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CritiqueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "group_code": {
            "type": "string",
            "title": "Group Code"
          },
          "interest_text": {
            "type": "string",
            "title": "Interest Text"
          },
          "law": {
            "$ref": "#/components/schemas/LawSummary"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "group_code",
          "interest_text",
          "law",
          "evidence"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient_evidence"
            ],
            "title": "Status"
          },
          "memo": {
            "items": {
              "$ref": "#/components/schemas/MemoSentence"
            },
            "type": "array",
            "title": "Memo"
          },
          "open_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Open Questions"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCallRecord"
            },
            "type": "array",
            "title": "Tool Calls"
          },
          "new_evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "New Evidence"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderInfo"
          }
        },
        "type": "object",
        "required": [
          "status",
          "memo",
          "open_questions",
          "tool_calls",
          "new_evidence",
          "provider"
        ],
        "title": "AnalyzeResponse"
      },
      "ClassifyRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "law": {
            "$ref": "#/components/schemas/LawSummary"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/GroupCandidate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Candidates"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "law",
          "candidates"
        ],
        "title": "ClassifyRequest"
      },
      "ClassifyResponse": {
        "properties": {
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupVerdict"
            },
            "type": "array",
            "title": "Groups"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderInfo"
          }
        },
        "type": "object",
        "required": [
          "groups",
          "provider"
        ],
        "title": "ClassifyResponse"
      },
      "CritiqueRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "memo": {
            "items": {
              "$ref": "#/components/schemas/MemoSentence"
            },
            "type": "array",
            "title": "Memo"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "use_rules": {
            "type": "boolean",
            "title": "Use Rules",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "memo",
          "evidence"
        ],
        "title": "CritiqueRequest"
      },
      "CritiqueResponse": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderInfo"
          }
        },
        "type": "object",
        "required": [
          "findings",
          "provider"
        ],
        "title": "CritiqueResponse"
      },
      "EmbedRequest": {
        "properties": {
          "texts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Texts"
          },
          "input_type": {
            "type": "string",
            "enum": [
              "query",
              "passage"
            ],
            "title": "Input Type"
          }
        },
        "type": "object",
        "required": [
          "texts",
          "input_type"
        ],
        "title": "EmbedRequest"
      },
      "EmbedResponse": {
        "properties": {
          "vectors": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Vectors"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderInfo"
          }
        },
        "type": "object",
        "required": [
          "vectors",
          "provider"
        ],
        "title": "EmbedResponse"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "body"
        ],
        "title": "Evidence"
      },
      "Finding": {
        "properties": {
          "sentence_index": {
            "type": "integer",
            "title": "Sentence Index"
          },
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "sentence_index",
          "rule_id",
          "message"
        ],
        "title": "Finding"
      },
      "GroupCandidate": {
        "properties": {
          "group_code": {
            "type": "string",
            "title": "Group Code"
          },
          "interest_text": {
            "type": "string",
            "title": "Interest Text"
          },
          "similarity": {
            "type": "number",
            "title": "Similarity"
          }
        },
        "type": "object",
        "required": [
          "group_code",
          "interest_text",
          "similarity"
        ],
        "title": "GroupCandidate"
      },
      "GroupVerdict": {
        "properties": {
          "group_code": {
            "type": "string",
            "title": "Group Code"
          },
          "relevant": {
            "type": "boolean",
            "title": "Relevant"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "관련성일 확률(0~1). 관련 없다고 판단하면 0에 가깝게, 관련 있다고 확신하면 1에 가깝게."
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "group_code",
          "relevant",
          "confidence",
          "reason"
        ],
        "title": "GroupVerdict"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LawSummary": {
        "properties": {
          "law_id": {
            "type": "string",
            "title": "Law Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "promulgation_date": {
            "type": "string",
            "format": "date",
            "title": "Promulgation Date"
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "title": "Effective Date",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "mst": {
            "type": "string",
            "title": "Mst",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "law_id",
          "name",
          "promulgation_date",
          "summary"
        ],
        "title": "LawSummary"
      },
      "MemoSentence": {
        "properties": {
          "sentence": {
            "type": "string",
            "title": "Sentence"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "sentence",
          "citations"
        ],
        "title": "MemoSentence"
      },
      "ProviderInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "nvidia",
              "fallback"
            ],
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "title": "ProviderInfo"
      },
      "ToolCallRecord": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Args"
          },
          "result_summary": {
            "type": "string",
            "title": "Result Summary"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "tool",
          "args",
          "result_summary",
          "evidence_ids"
        ],
        "title": "ToolCallRecord"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
